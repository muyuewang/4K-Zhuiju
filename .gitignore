# ---------- Flutter / Dart ----------
.dart_tool/
.packages
.pub-cache/
.pub/
build/
*.iml
.idea/
.vscode/
*.log
.flutter-plugins
.flutter-plugins-dependencies

# Flutter 生成的桌面/移动平台脚手架产物
code/flutter_app/windows/flutter/ephemeral/
code/flutter_app/android/.gradle/
code/flutter_app/android/local.properties
code/flutter_app/android/key.properties
code/flutter_app/android/app/debug/
code/flutter_app/android/app/profile/
code/flutter_app/android/app/release/
code/flutter_app/ios/Pods/
code/flutter_app/macos/Pods/

# ---------- 签名与密钥 ----------
*.jks
*.keystore
*.p12
*.pem
key.properties

# ---------- 工作区规范目录（不进仓库）----------
# dist/ 是打包产物，走 GitHub Releases 分发，不进源码历史
dist/
logs/
out/

# 逆向分析中间产物（APK 解包、提取的字符串表、密钥试探脚本等）
# 体积大且含第三方 App 内容，只在本机留存，不入库
.tmp/

# 临时探针/抓取脚本（本地调试用，不是产品代码）
code/tmp/

# QuickJS 原生库：跑 flutter test 时由 test/support/quickjs_env.dart
# 从 pub cache 现拷到 cwd。它是第三方包的产物（677KB 二进制），
# 且会随 flutter_js 版本变化——提交进来会导致「代码是新的、dll 是旧的」。
# 打包产物由 CMake install 规则负责拷贝，不依赖仓库里这份。
code/flutter_app/quickjs_c_bridge.dll
code/flutter_app/libquickjs_c_bridge_plugin.so

# ---------- 调试临时文件 ----------
u*.xml
ui*.xml
shot*.png
shot*.jpg
d[0-9].png
d[0-9].jpg
v[0-9].png
v[0-9].jpg
t[0-9].png
t[0-9].jpg
q[0-9].png
w[0-9].png
n[0-9].png
dl[0-9].png
s.png
s.jpg
*.bak

# ---------- 系统 ----------
.DS_Store
Thumbs.db
desktop.ini
# 临时工作目录（调试脚本产物、一次性探针）
.tmp2/
.workbuddy/tmp/

# Python 字节码缓存（probe 脚本运行后到处留，且与 Python 版本绑定）
__pycache__/
*.pyc

# 探针抓到的原始响应（几十 KB 的密文，只用来对拍一次；
# 定型后的样本已经放进 test/fixtures/，这里不必进仓库）
code/tools/_sjz_out/

# APK 解包出的临时内容（classes.dex 9MB、assets 配置）。
# 只用来查一次授权链路，结论已写进 config/plugins/sanjiaozhou.js 的注释，
# 原始 dex 没有任何保留价值，进仓库只会把仓库撑大。
code/tools/_sjz_apk/

# NewTV（base.apk）解包内容，154MB，同样只用于一次性分析。
# 结论：该源依赖登录态且服务端不可达，无可提取的可用源。
code/tools/_newtv/

# 探流临时产物（curl 抓回的前 8KB 样本）
code/tools/_probe.bin

# adb logcat 抓包残留（排查直播/启动问题时导出，一次性）
logcat_dump.txt
